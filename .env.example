# Copy to .env (read by both Next.js and the Prisma CLI). .env.local also works for Next.js,
# but Prisma CLI commands (migrate, seed) only read .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connecthr?schema=public"
NEXT_PUBLIC_APP_NAME="Connect HR"

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional. Shown on the membership page so members know how to pay (bank account, JazzCash/Easypaisa number, etc.).
# Use \n for line breaks. When empty, members are told the team will contact them.
PAYMENT_INSTRUCTIONS=""

# Optional. Database used by `npm test`. Defaults to DATABASE_URL with the database name replaced by connecthr_test.
# The name MUST contain "test" — the test suite empties every table in it.
TEST_DATABASE_URL=""

# --- Legacy TaskMarket (retired). Leave unset unless you deliberately re-enable the old endpoints. ---
LEGACY_TASKMARKET_ENABLED=""
ADDRESS_ENCRYPTION_KEY=""
CRON_SECRET=""
