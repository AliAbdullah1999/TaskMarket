# Copy to .env (read by both Next.js and the Prisma CLI). .env.local also works for Next.js,
# but Prisma CLI commands (migrate, seed) only read .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connecthr?schema=public"
NEXT_PUBLIC_APP_NAME="Connect HR"

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Public address of the site, without a trailing slash. Used for links in emails, the sitemap and robots.txt.
APP_URL="http://localhost:3000"

# Email (password reset, email confirmation, notifications). Choose ONE of the two options.
# Without either, development prints emails to the server console and production sends nothing.
#
# Option A - a mailbox over SMTP, e.g. Gmail (good for demos; Gmail allows about 500 emails a day):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password at https://myaccount.google.com/apppasswords and paste it below without spaces.
#   SMTP_HOST and SMTP_PORT default to Gmail (smtp.gmail.com, 465).
SMTP_USER=""
SMTP_PASS=""
SMTP_HOST=""
SMTP_PORT=""
#
# Option B - Resend (https://resend.com), for a domain you own. EMAIL_FROM must be on a domain verified there.
RESEND_API_KEY=""
# Sender shown to recipients, e.g. "Connect HR <no-reply@yourdomain.pk>". Required for Resend; optional for SMTP.
EMAIL_FROM=""

# Secret for the daily maintenance endpoint (/api/cron/daily). Generate like SESSION_SECRET.
CRON_SECRET=""

# Shown on the Terms and Privacy pages, the footer, and /.well-known/security.txt. Set both before launch.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_LEGAL_ENTITY=""

# Optional. Shown on the membership page so members know how to pay (bank account, JazzCash/Easypaisa number, etc.).
# Use \n for line breaks. When empty, members are told the team will contact them.
PAYMENT_INSTRUCTIONS=""

# Optional. Database used by `npm test`. Defaults to DATABASE_URL with the database name replaced by connecthr_test.
# The name MUST contain "test" — the test suite empties every table in it.
TEST_DATABASE_URL=""

