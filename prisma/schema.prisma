generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String            @id @default(cuid())
  fullName              String
  email                 String            @unique
  passwordHash          String
  phone                 String?
  country               String            @default("PK")
  city                  String?
  userType              UserType
  businessName          String?
  status                UserStatus        @default(ACTIVE)
  /// Incremented to invalidate every existing session (password change, sign out everywhere).
  sessionVersion        Int               @default(0)
  /// When the user accepted the Terms and Privacy Policy at registration.
  termsAcceptedAt       DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  taskerProfile         TaskerProfile?
  candidateProfile      CandidateProfile?
  employerProfile       EmployerProfile?
  postedJobs            Job[]             @relation("EmployerJobs")
  applications          JobApplication[]  @relation("CandidateApplications")
  reviewedApps          JobApplication[]  @relation("EmployerReviews")
  subscriptions         Subscription[]    @relation("SubscriptionOwner")
  customerTasks         Task[]            @relation("CustomerTasks")
  assignedTasks         Task[]            @relation("TaskerAssignments")
  quotes                Quote[]
  messages              Message[]
  ratingsGiven          Rating[]          @relation("RatingsGiven")
  ratingsReceived       Rating[]          @relation("RatingsReceived")
  payouts               Payout[]
  fbrReportRecords      FBRReportRecord[]
  reviewedSubscriptions Subscription[]    @relation("SubscriptionReviewer")
  adminActions          AdminAuditLog[]
}

model TaskerProfile {
  id                    String           @id @default(cuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ntin                  String?
  ntinVerified          Boolean          @default(false)
  verificationTier      VerificationTier @default(BASIC)
  categories            String[]
  serviceAreas          String[]
  bio                   String?
  priceFrom             Int?
  rating                Float            @default(0)
  ratingCount           Int              @default(0)
  completedJobs         Int              @default(0)
  backgroundCheckStatus BackgroundStatus @default(PENDING)
  status                ProfileStatus    @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model CandidateProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline         String?
  summary          String?
  skills           String[]
  /// Lower-cased copy of skills for case-insensitive search. Maintained by lib/services/profiles.ts.
  skillsNormalized String[] @default([])
  experienceYears  Int?
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isPublic, updatedAt])
}

model EmployerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  industry    String?
  description String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Job {
  id             String           @id @default(cuid())
  employerId     String
  employer       User             @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Cascade)
  title          String
  description    String
  requirements   String?
  category       String
  city           String
  employmentType EmploymentType
  workplaceType  WorkplaceType
  salaryMin      Int?
  salaryMax      Int?
  status         JobStatus        @default(OPEN)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]

  @@index([status, city, category, createdAt])
  @@index([employerId, status])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User              @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String
  employer    User              @relation("EmployerReviews", fields: [employerId], references: [id], onDelete: Cascade)
  coverLetter String?
  status      ApplicationStatus @default(SUBMITTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([employerId, status, createdAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation("SubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan
  status             SubscriptionStatus @default(REQUESTED)
  /// Reference the member supplied with their request (unverified).
  requestedReference String?
  /// Reference the administrator confirmed when approving.
  paymentReference   String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?              @relation("SubscriptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, status, currentPeriodEnd])
  @@index([status, createdAt])
}

/// Fixed-window counters for throttling sign-in, sign-up and other sensitive actions.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model Task {
  id                String             @id @default(cuid())
  title             String
  description       String
  category          String
  serviceType       String
  city              String
  neighborhood      String?
  budgetMin         Int?
  budgetMax         Int?
  preferredDate     DateTime?
  durationHours     Int?
  status            TaskStatus         @default(OPEN)
  customerId        String
  customer          User               @relation("CustomerTasks", fields: [customerId], references: [id])
  taskerId          String?
  tasker            User?              @relation("TaskerAssignments", fields: [taskerId], references: [id])
  requirements      Json?
  addressMode       AddressMode        @default(DISCLOSED_AFTER_ESCROW)
  addressEncrypted  String?
  taskerCompletedAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  quotes            Quote[]
  escrowTransaction EscrowTransaction?
  messages          Message[]
  ratings           Rating[]

  @@index([status, category, city])
  @@index([customerId])
  @@index([taskerId])
}

model Quote {
  id           String      @id @default(cuid())
  taskId       String
  task         Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskerId     String
  tasker       User        @relation(fields: [taskerId], references: [id])
  quoteText    String
  amountPKR    Int
  etaHours     Int
  scopeSummary String
  status       QuoteStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  expiresAt    DateTime?

  @@unique([taskId, taskerId])
}

model EscrowTransaction {
  id               String            @id @default(cuid())
  taskId           String            @unique
  task             Task              @relation(fields: [taskId], references: [id])
  customerId       String
  taskerId         String
  amount           Int
  commissionPct    Int               @default(11)
  commissionAmount Int
  netAmount        Int
  status           EscrowStatus      @default(FUNDED)
  paymentMethod    String?
  paymentReference String?
  createdAt        DateTime          @default(now())
  escrowedAt       DateTime?
  autoReleaseAt    DateTime?
  releasedAt       DateTime?
  refundedAt       DateTime?
  payout           Payout?
  fbrRecords       FBRReportRecord[]
}

model Payout {
  id                  String            @id @default(cuid())
  escrowTransactionId String            @unique
  escrowTransaction   EscrowTransaction @relation(fields: [escrowTransactionId], references: [id])
  taskerId            String
  tasker              User              @relation(fields: [taskerId], references: [id])
  grossAmount         Int
  commissionAmount    Int
  netAmount           Int
  paymentMethod       String            @default("bank_transfer")
  status              PayoutStatus      @default(PENDING)
  paidAt              DateTime?
  createdAt           DateTime          @default(now())
}

model Message {
  id              String          @id @default(cuid())
  taskId          String
  task            Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User            @relation(fields: [senderId], references: [id])
  channelType     MessageChannel  @default(IN_APP)
  body            String
  visibilityState VisibilityState @default(ACTIVE)
  createdAt       DateTime        @default(now())
  flagged         Boolean         @default(false)

  @@index([taskId, createdAt])
}

model Rating {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUserId      String
  fromUser        User     @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUserId        String
  toUser          User     @relation("RatingsReceived", fields: [toUserId], references: [id])
  overall         Int
  punctuality     Int
  professionalism Int
  communication   Int
  comment         String?
  createdAt       DateTime @default(now())

  @@unique([taskId, fromUserId])
}

model FBRReportRecord {
  id                  String             @id @default(cuid())
  reportMonth         DateTime
  sellerId            String
  seller              User               @relation(fields: [sellerId], references: [id])
  taskId              String?
  transactionId       String?
  grossSales          Int
  commissionAmount    Int
  netPayout           Int
  status              FBRStatus          @default(PENDING)
  createdAt           DateTime           @default(now())
  escrowTransactionId String?
  escrowTransaction   EscrowTransaction? @relation(fields: [escrowTransactionId], references: [id])

  @@index([reportMonth, sellerId])
}

enum UserType {
  CUSTOMER
  TASKER
  BUSINESS
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

enum SubscriptionPlan {
  CANDIDATE_PRO
  EMPLOYER_GROWTH
}

enum SubscriptionStatus {
  REQUESTED
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  BANNED
}

enum VerificationTier {
  BASIC
  TRUSTED
  HIGH_TRUST
}

enum BackgroundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

enum TaskStatus {
  OPEN
  MATCHED
  ASSIGNED
  ESCROW_ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  EXPIRED
}

enum AddressMode {
  HIDDEN
  DISCLOSED_AFTER_ESCROW
}

enum QuoteStatus {
  ACTIVE
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum EscrowStatus {
  PENDING
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum MessageChannel {
  IN_APP
  VOICE_PROXY
  SYSTEM
}

enum VisibilityState {
  ACTIVE
  MASKED
  READ_ONLY
  CLOSED
}

enum FBRStatus {
  PENDING
  GENERATED
  ARCHIVED
}
