generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String            @id @default(cuid())
  fullName              String
  email                 String            @unique
  passwordHash          String
  phone                 String?
  country               String            @default("PK")
  city                  String?
  userType              UserType
  businessName          String?
  status                UserStatus        @default(ACTIVE)
  /// Incremented to invalidate every existing session (password change, sign out everywhere).
  sessionVersion        Int               @default(0)
  /// When the user accepted the Terms and Privacy Policy at registration.
  termsAcceptedAt       DateTime?
  /// When the user proved they control this email address (verification link or password reset).
  emailVerifiedAt       DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  candidateProfile      CandidateProfile?
  employerProfile       EmployerProfile?
  postedJobs            Job[]             @relation("EmployerJobs")
  applications          JobApplication[]  @relation("CandidateApplications")
  reviewedApps          JobApplication[]  @relation("EmployerReviews")
  subscriptions         Subscription[]    @relation("SubscriptionOwner")
  reviewedSubscriptions Subscription[]    @relation("SubscriptionReviewer")
  adminActions          AdminAuditLog[]
  authTokens            AuthToken[]
  invitationsSent       JobInvitation[]   @relation("InvitationsSent")
  invitationsReceived   JobInvitation[]   @relation("InvitationsReceived")
}

model CandidateProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline         String?
  summary          String?
  skills           String[]
  /// Lower-cased copy of skills for case-insensitive search. Maintained by lib/services/profiles.ts.
  skillsNormalized String[] @default([])
  experienceYears  Int?
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isPublic, updatedAt])
}

model EmployerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  industry    String?
  description String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Job {
  id             String           @id @default(cuid())
  employerId     String
  employer       User             @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Cascade)
  title          String
  description    String
  requirements   String?
  category       String
  city           String
  employmentType EmploymentType
  workplaceType  WorkplaceType
  salaryMin      Int?
  salaryMax      Int?
  status         JobStatus        @default(OPEN)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]
  invitations    JobInvitation[]
  /// Set when an administrator removes the listing (status ARCHIVED). Shown to the employer.
  removedReason  String?

  @@index([status, city, category, createdAt])
  @@index([employerId, status])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User              @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String
  employer    User              @relation("EmployerReviews", fields: [employerId], references: [id], onDelete: Cascade)
  coverLetter String?
  status      ApplicationStatus @default(SUBMITTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([employerId, status, createdAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation("SubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan
  status                SubscriptionStatus @default(REQUESTED)
  /// Reference the member supplied with their request (unverified).
  requestedReference    String?
  /// Reference the administrator confirmed when approving.
  paymentReference      String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewedBy            User?              @relation("SubscriptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote            String?
  /// When the "your membership ends soon" email was sent, so it is sent only once.
  renewalReminderSentAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId, status, currentPeriodEnd])
  @@index([status, createdAt])
}

/// An employer's invitation for a searchable candidate to apply to one of their jobs.
model JobInvitation {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employerId  String
  employer    User     @relation("InvitationsSent", fields: [employerId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User     @relation("InvitationsReceived", fields: [candidateId], references: [id], onDelete: Cascade)
  message     String?
  createdAt   DateTime @default(now())

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([employerId, createdAt])
}

/// Single-use links emailed to a user. Only a SHA-256 hash of the token is stored.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Fixed-window counters for throttling sign-in, sign-up and other sensitive actions.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum UserType {
  CUSTOMER
  TASKER
  BUSINESS
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

enum SubscriptionPlan {
  CANDIDATE_PRO
  EMPLOYER_GROWTH
}

enum SubscriptionStatus {
  REQUESTED
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  BANNED
}
